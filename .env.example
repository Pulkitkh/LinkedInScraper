# Copy to .env and fill in. Never commit .env.

# --- LinkedIn Credentials ---
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# --- Gmail Credentials (SMTP/IMAP) ---
# Use a Gmail App Password, not your normal password.
# Create one under Google Account > Security > 2-Step Verification > App passwords.
GMAIL_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Copied on outreach emails (in addition to the candidate) / blind-copied
TEAM_LEAD_EMAIL=
ADMIN_EMAIL=

# --- AI API Keys & Configurations ---
# Primary model for resume customization
GEMINI_API_KEY=
# Leave as is: the latest Flash model. If a model is retired, a current one is picked automatically.
GEMINI_MODEL=gemini-flash-latest

# Fallback model, also used first for follow-up value propositions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Secondary fallback model
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional ---
# true = watch the browser search LinkedIn (options 3/8 default to a visible window). Good for demos.
SHOW_BROWSER=false
# Use your installed browser instead of Playwright's Chromium: msedge (Windows) or chrome
BROWSER_CHANNEL=
# Chromium binary if Playwright's bundled browser isn't installed
CHROMIUM_EXECUTABLE=
